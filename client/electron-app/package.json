{
  "name": "neural-gateway-lachlanm05",
  "version": "1.2.8",
  "description": "Neural Gateway Node Client",
  "main": "main.js",
  "author": "LachlanM05 <lachlan@lachlanm05.com>",
  "homepage": "https://ai.lachlanm05.com",
  "scripts": {
    "start": "electron .",
    "clean": "rimraf dist",
    "dist": "npm run clean && electron-builder"
  },
  "build": {
    "appId": "com.lachlanm05.ai",
    "productName": "Neural Gateway",
    "publish": [
      {
        "provider": "generic",
        "url": "https://lachlanm05.com/ai/updater/"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "logo.icns" 
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "logo.png"
    }
  },
  "dependencies": {
    "auto-launch": "^5.0.5",
    "axios": "^1.6.0",
    "electron-updater": "^6.6.2",
    "systeminformation": "^5.21.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "rimraf": "^5.0.10"
  }
}
