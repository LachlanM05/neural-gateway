<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Forgot Password // NeuralGateway</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="splash-container">
    <div class="splash-card">
      <div class="kicker">Account Recovery</div>
      <h1>Forgot Password.</h1>
      <p class="muted">Enter your email to receive a reset link.</p>
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background: rgba(255,0,0,0.1); color: var(--danger); padding: 10px; border-radius: 4px; margin-top: 10px; border: 1px solid var(--danger);">
          <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div style="background: rgba(0,255,0,0.1); color: #4ade80; padding: 10px; border-radius: 4px; margin-top: 10px; border: 1px solid #4ade80;">
          <%= success %>
        </div>
      <% } %>

      <form action="/forgot-password" method="POST" style="margin-top: 24px;">
        <input type="email" name="email" placeholder="Email Address" required autocomplete="email">
        <button type="submit" class="btn-primary" style="width: 100%; margin-top: 10px;">Send Reset Link</button>
      </form>

      <div style="margin-top: 20px; font-size: 0.8rem;">
        <a href="/login" class="muted">← Back to Login</a>
      </div>
    </div>
  </div>
</body>
</html>
