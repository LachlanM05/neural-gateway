<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Reset Password // NeuralGateway</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="splash-container">
    <div class="splash-card">
      <div class="kicker">Account Recovery</div>
      <h1>New Password.</h1>
      <p class="muted">Enter a new strong password.</p>
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background: rgba(255,0,0,0.1); color: var(--danger); padding: 10px; border-radius: 4px; margin-top: 10px; border: 1px solid var(--danger);">
          <%= error %>
        </div>
      <% } %>

      <form action="/reset-password" method="POST" style="margin-top: 24px;">
        <input type="hidden" name="token" value="<%= token %>">
        <input type="password" name="password" placeholder="New Password" required minlength="6">
        <button type="submit" class="btn-primary" style="width: 100%; margin-top: 10px;">Set Password</button>
      </form>
    </div>
  </div>
</body>
</html>
